# A .reel script is just the demo you would give by hand, written down.
# Run it with:  npx flowreel examples/demo.reel

visit http://localhost:3000
viewport 1280x800

# Give a dev server a moment to finish mounting before the first click.
wait idle

click "Sign in"
type "#email" "demo@example.com"
press Enter

# Targets are matched by button label first, then visible text, then CSS.
wait "#dashboard"
hover ".card"
scroll down 400
wait 800

# No extension: the preset decides. `output demo.gif` would emit only the GIF.
output demo
